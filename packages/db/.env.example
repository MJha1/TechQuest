# Neon PostgreSQL connection strings used by Prisma.
# Copy to `.env` and fill in. Never commit the real `.env`.
#
# DATABASE_URL: pooled connection (used by the app at runtime).
# DIRECT_URL:   direct (non-pooled) connection (used for migrations).
# On Neon these differ; locally they can be identical.

DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"
