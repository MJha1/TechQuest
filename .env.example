# ─────────────────────────────────────────────────────────────────────────────
# TechQuest — environment for the production (single-container) deployment.
#
# Copy to `.env` (or set these as Railway service variables) and fill in real
# values. NEVER commit a real `.env`. Every value here is SERVER-side and is read
# at RUNTIME — nothing is baked into the image.
#
# The frontend is served same-origin by Express, so the browser calls /api on the
# same host: no client API URL is needed. (PostHog is the one client-side value,
# and it is a build-time arg — see the notes at the bottom.)
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV="production"
# Railway injects PORT automatically; the app listens on it. Locally, defaults to 3001.
# PORT="3001"

# ── Database (Prisma / PostgreSQL) ───────────────────────────────────────────
# Pooled connection used by the app at runtime. On Railway, reference the
# Postgres plugin, e.g. DATABASE_URL="${{Postgres.DATABASE_URL}}".
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"
# Direct (non-pooled) connection used by `prisma migrate`. Can equal DATABASE_URL
# if you don't use a pooler.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# ── Better Auth (parent authentication) ──────────────────────────────────────
# Secret used to sign sessions/cookies. Generate: `openssl rand -base64 32`.
# Startup FAILS in production if left at the dev default. Keep it server-side.
BETTER_AUTH_SECRET="CHANGE_ME_openssl_rand_base64_32"
# Public URL the app is served from (used for cookie/callback URLs). On Railway
# this is your service domain.
BETTER_AUTH_URL="https://your-app.up.railway.app"

# Allowed browser origin(s), comma-separated. Also used as Better Auth trusted
# origins. Same-origin deploys set this to the public URL above.
CORS_ORIGINS="https://your-app.up.railway.app"

# ── AI (server-side only; the key NEVER reaches the browser) ─────────────────
# Leave empty to disable AI hints (a safe fallback is used instead).
ANTHROPIC_API_KEY=""
# Model for hints (default shown). Use a smaller model for cheaper hints.
AI_MODEL="claude-opus-5"
AI_HINT_TIMEOUT_MS="8000"

# ── Optional tuning (defaults shown) ─────────────────────────────────────────
# RATE_LIMIT_WINDOW_MS="900000"
# RATE_LIMIT_MAX="100"
# BODY_LIMIT="32kb"
# LOG_LEVEL="info"

# ── PostHog product analytics (CLIENT-side → BUILD-time) ─────────────────────
# PostHog runs in the browser, so its key is inlined by Vite at BUILD time, not
# read at runtime. To enable it, pass these as Docker build args (Railway:
# set them as build-time variables). The PostHog *project* key is public, not a
# secret. Leave unset to ship with analytics disabled.
# VITE_POSTHOG_KEY="phc_..."
# VITE_POSTHOG_HOST="https://us.i.posthog.com"
