# TechQuest web environment.
# Only VITE_-prefixed vars are exposed to the browser bundle — never put secrets here.

# API origin. Leave empty in dev (Vite proxies /api to the Express server on :3001).
# In production set this to the API's public origin, e.g. https://api.techquest.app
VITE_API_URL=""

# PostHog product analytics. Leave the key empty to disable analytics entirely
# (dev + tests send nothing). The project key is public by design (client-side).
VITE_POSTHOG_KEY=""
VITE_POSTHOG_HOST="https://us.i.posthog.com"
