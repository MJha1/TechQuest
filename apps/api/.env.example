# TechQuest API environment.
# Copy to `.env` and fill in real values. NEVER commit the real `.env`.
# Every value here is server-side only — none of it is exposed to the frontend.

# Runtime
NODE_ENV="development"
PORT="3001"

# Allowed browser origins (comma-separated). Also used as Better Auth trusted origins.
CORS_ORIGINS="http://localhost:5173"

# --- Better Auth (parent authentication) ---
# Secret used to sign sessions/cookies. MUST be a long random string in
# production (startup fails if left at the dev default). Generate one with:
#   openssl rand -base64 32
# SECURITY: keep this server-side. Never ship it to the browser bundle.
BETTER_AUTH_SECRET="dev-insecure-change-me-in-production"
# Public base URL the API is served from (used for cookie/callback URLs).
BETTER_AUTH_URL="http://localhost:3001"

# --- Database ---
# Better Auth persists users/sessions via the shared Prisma client, which reads
# these from the environment at runtime. See packages/db/.env.example for the
# pooled vs. direct (migration) connection-string guidance.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Optional tuning (defaults shown)
# RATE_LIMIT_WINDOW_MS="900000"
# RATE_LIMIT_MAX="100"
# BODY_LIMIT="32kb"
# LOG_LEVEL="info"
