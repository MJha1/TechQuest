# ─────────────────────────────────────────────────────────────────────────────
# TechQuest — production environment (single-container deploy, e.g. Railway).
#
# These are the RUNTIME service variables the API reads on boot. On Railway, set
# them under Service → Variables (do NOT commit real values). Every value here is
# SERVER-side — nothing is baked into the image or exposed to the browser.
#
# The frontend is served same-origin by Express, so the browser calls /api on the
# same host; no client API URL is needed. (PostHog is the one client-side value,
# and it is a BUILD-time arg — see the notes at the bottom.)
#
# Startup is fail-fast: the API validates this config at import time and CRASHES
# on boot if a required production value is missing or left at a dev default —
# which surfaces as a Railway healthcheck failure ("service unavailable"), not a
# build error.
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV="production"
# Railway injects PORT automatically and the app listens on it (binding 0.0.0.0).
# Leave unset on Railway; locally it defaults to 3001.
# PORT="3001"

# ── Database (Prisma / PostgreSQL) — REQUIRED ────────────────────────────────
# Pooled connection used by the app at runtime. On Railway, reference the
# Postgres plugin, e.g. DATABASE_URL="${{Postgres.DATABASE_URL}}".
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"
# Direct (non-pooled) connection used by `prisma migrate`. May equal DATABASE_URL
# if you don't use a pooler.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# ── Better Auth (parent authentication) — REQUIRED ───────────────────────────
# Secret used to sign sessions/cookies. Generate: `openssl rand -base64 32`.
# Production startup FAILS if this is missing or left at the dev default. Keep it
# server-side; never ship it to the browser bundle.
BETTER_AUTH_SECRET="CHANGE_ME_openssl_rand_base64_32"
# Public URL the app is served from (used for cookie/callback URLs). On Railway
# this is your service domain.
BETTER_AUTH_URL="https://your-app.up.railway.app"

# Allowed browser origin(s), comma-separated. Also used as Better Auth trusted
# origins. Same-origin deploys set this to the public URL above.
CORS_ORIGINS="https://your-app.up.railway.app"

# ── AI (server-side only; the key NEVER reaches the browser) — OPTIONAL ───────
# Leave empty to disable AI hints (a safe fallback is used instead).
ANTHROPIC_API_KEY=""
# Model for hints (default shown). Use a smaller model for cheaper hints.
AI_MODEL="claude-opus-5"
AI_HINT_TIMEOUT_MS="8000"

# ── Optional tuning (defaults shown) ─────────────────────────────────────────
# RATE_LIMIT_WINDOW_MS="900000"
# RATE_LIMIT_MAX="100"
# BODY_LIMIT="32kb"
# LOG_LEVEL="info"

# ── PostHog product analytics (CLIENT-side → BUILD-time, NOT runtime) ─────────
# PostHog runs in the browser, so its key is inlined by Vite at BUILD time. To
# enable it, pass these as Docker build args (Railway: set them as build-time
# variables), NOT as the runtime service variables above. The PostHog *project*
# key is public, not a secret. Leave unset to ship with analytics disabled.
# VITE_POSTHOG_KEY="phc_..."
# VITE_POSTHOG_HOST="https://us.i.posthog.com"
